# ZettaBrainSkill Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# LLM Provider
LLM_PROVIDER=ollama  # ollama, vllm, litellm
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Storage
SKILL_STORAGE_PATH=./data/skills
CORPUS_STORAGE_PATH=./data/corpus
DISCOVERY_STORAGE_PATH=./data/discovery
OUTPUT_STORAGE_PATH=./data/outputs

# API (for future use)
API_HOST=0.0.0.0
API_PORT=8000
